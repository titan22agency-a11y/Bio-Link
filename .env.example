# ─── Core ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Root domain that serves the admin panel and the marketing site.
# Client pages are served at <slug>.ROOT_DOMAIN and at ROOT_DOMAIN/<slug>.
ROOT_DOMAIN=ourdomain.com
# Public base URL of the app (used for canonical URLs, OG tags, auth callbacks).
NEXT_PUBLIC_APP_URL=https://ourdomain.com
# Subdomains that must never be treated as a client slug.
RESERVED_SUBDOMAINS=www,admin,app,api,static,cdn,mail

# ─── Database (PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL=postgresql://linkdeck:change-me@localhost:5432/linkdeck?schema=public
# Used only by docker-compose to initialise the postgres container.
POSTGRES_USER=linkdeck
POSTGRES_PASSWORD=change-me
POSTGRES_DB=linkdeck

# ─── Auth (NextAuth, JWT sessions) ─────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-random-32-bytes
NEXTAUTH_URL=https://ourdomain.com

# First admin account created by `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@ourdomain.com
SEED_ADMIN_PASSWORD=change-me-now

# ─── Analytics ─────────────────────────────────────────────────────────
# Salt for hashing visitor IPs (no raw IPs are stored). openssl rand -hex 16
ANALYTICS_SALT=replace-with-random-hex

# ─── Uploads ───────────────────────────────────────────────────────────
# Absolute path where uploaded images are written. Nginx serves /uploads from here.
UPLOAD_DIR=/var/www/linkdeck/uploads
UPLOAD_MAX_MB=5

# ─── Phase 2 feature flags (keep false until launch) ───────────────────
SELF_SIGNUP_ENABLED=false
PAYMENTS_ENABLED=false

# ─── Phase 2: Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=

# ─── Phase 2: Paymob (Egypt) ───────────────────────────────────────────
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=

# ─── Phase 2: Fawry (Egypt) ────────────────────────────────────────────
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=
FAWRY_BASE_URL=https://atfawry.fawrystaging.com
